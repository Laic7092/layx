# Shared team coordination scratch (env.sh, contract, local Go caches)
.team/

# Python bytecode from scripts/*.py
__pycache__/
*.py[cod]

# Go test binaries and profiles
*.test
*.out
*.prof
*.mem
coverage.*

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Generated wasm demo assets: run ./examples/wasm/build.sh to produce them.
examples/wasm/web/layx.wasm
examples/wasm/web/wasm_exec.js
examples/wasm/web/wasm_exec_node.js
examples/wasm/web/fonts/

# Rendering snapshots are build products (scripts/snapshot.sh)
snapshots/

# Real-book EPUB samples are not committed; copy them in to run the sample
# tests (see epub/testdata/samples/README.md).
epub/testdata/samples/*.epub
